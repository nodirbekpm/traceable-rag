# Copy to .env and fill in. Blank values fall back to local development defaults.

# Required by SEC for every request: "Full Name email@example.com"
EDGAR_USER_AGENT=

# Language model (extraction and answers). A free Gemini key is enough:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Local embedding model, runs on CPU. A model with a different vector size needs a migration.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# PostgreSQL (docker compose)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Only when running the app outside Docker
DATABASE_URL=
REDIS_URL=
RAW_STORAGE_DIR=
